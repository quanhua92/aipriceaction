# Defaults are for loopback development. Relative application paths resolve here.
RUSTFS_IMAGE=rustfs/rustfs@sha256:8cc9801755448b71a786705ce76692c77e14936cccd87cf2fc31842e58f4d1ff
RUSTFS_API_PORT=9100
RUSTFS_CONSOLE_PORT=9101
AIPA_API_PORT=3001
# Host directory mounted at /data. Colima must share this exact path; for a
# workspace under /Volumes, prefer an equivalent path rooted under /Users.
AIPA_DATA_DIR=./data
AWS_ACCESS_KEY_ID=aipa-local
AWS_SECRET_ACCESS_KEY=aipa-local-development-only
AWS_DEFAULT_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9100
S3_BUCKET=aipriceaction-api-local
S3_PREFIX=archive-v2
S3_FORCE_PATH_STYLE=true
ARCHIVE_BACKEND=s3
SQLITE_PATH=./data/aipriceaction.sqlite3
ARCHIVE_CACHE_PATH=./data/archive-cache
ARCHIVE_OBJECT_PATH=./data/objects
ARCHIVE_CACHE_BYTES=536870912
ARCHIVE_MAX_ROWS=5000000
DAILY_RETENTION_YEARS=3
HOURLY_RETENTION_YEARS=3
MINUTE_RETENTION_YEARS=1
WATCHLIST_PATH=./watchlist.json
# `catalog` expands ingestion to every VN, crypto and Yahoo symbol in the
# live catalog snapshot. Compose refreshes that snapshot during initialization.
INGEST_UNIVERSE=watchlist
CATALOG_BASE_URL=https://api.aipriceaction.com
CATALOG_SNAPSHOT_PATH=./data/catalog-snapshot.json
# Optional ordered export from the retiring Rust PostgreSQL tickers table.
RUST_TICKER_IDENTITY_ORDER_PATH=
VN_PROVIDERS=vps,vndirect,dnse
# Optional last-resort older-minute source; does not change the preferred providers.
VCI_HISTORY_FALLBACK=false
# Optional JSON list of replayable, corroborated volume proofs; no implicit corrections.
VCI_VOLUME_PROOFS=
# Supply HTTP/SOCKS proxies or explicitly permit direct requests.
# --allow-direct permits direct requests for one CLI invocation only.
ALLOW_DIRECT=false
HTTP_PROXIES=
PROVIDER_RPM=30
WORKER_CONCURRENCY=3
API_READ_CONCURRENCY=4
# Keep broad market/RRG reads within the web client's 30-second request budget.
API_MARKET_READ_CONCURRENCY=4
API_MAX_LIMIT=40
REDIS_DAILY_MAX_SIZE=5000
REDIS_HOURLY_MAX_SIZE=30000
REDIS_MINUTE_MAX_SIZE=20000
# Optional Rust-compatible live cache. Leave empty for SQLite-emulated local reads.
REDIS_URL=
# Local-development Vite origins; production should keep only the two public HTTPS origins.
CORS_ORIGINS=https://aipriceaction.com,https://api.aipriceaction.com,http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.13:5173
AIPA_LOG_LEVEL=INFO
# Comma-separated bearer tokens. Sync endpoints stay disabled until configured.
SYNC_TOKEN=
# Rust treats an explicitly empty refresh key as configured; set a non-empty value.
REFRESH_SECRET=
