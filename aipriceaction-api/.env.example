# Deployment settings: replace these values when pointing Compose at production.
# Set the API secret and production S3 endpoint, bucket, and write credentials.
# These local values keep development on local RustFS.
REFRESH_SECRET=
# For host-run CLI commands, use http://127.0.0.1:9100 instead.
S3_ENDPOINT=http://rustfs:9000
S3_BUCKET=aipriceaction-api-local
AWS_ACCESS_KEY_ID=aipa-local
AWS_SECRET_ACCESS_KEY=aipa-local-development-only

# Optional overrides. Ports and the pinned RustFS image have defaults in Compose.
# Host directory mounted at /data. Colima must share this exact path; for a
# workspace under /Volumes, prefer an equivalent path rooted under /Users.
AIPA_DATA_DIR=./data
AWS_DEFAULT_REGION=us-east-1
S3_PREFIX=parquet
S3_FORCE_PATH_STYLE=true
ARCHIVE_BACKEND=s3
# The worker always publishes Rust-compatible CSV objects at the root of this
# same bucket after successful ingestion. In production this bucket is public.
PUBLIC_EXPORT_ENABLED=true
SQLITE_PATH=./data/aipriceaction.sqlite3
ARCHIVE_CACHE_PATH=./data/archive-cache
ARCHIVE_OBJECT_PATH=./data/objects
ARCHIVE_CACHE_BYTES=536870912
ARCHIVE_MAX_ROWS=5000000
DAILY_RETENTION_YEARS=3
HOURLY_RETENTION_YEARS=3
MINUTE_RETENTION_YEARS=1
WATCHLIST_PATH=./watchlist.json
# `catalog` ingests every symbol in the bundled local symbol files.
# Set `watchlist` to limit ingestion to the configured watchlist.
INGEST_UNIVERSE=catalog
# Optional ordered export from the retiring Rust PostgreSQL tickers table.
RUST_TICKER_IDENTITY_ORDER_PATH=
VN_PROVIDERS=vps,vndirect,dnse
# Optional last-resort older-minute source; does not change the preferred providers.
VCI_HISTORY_FALLBACK=false
# Optional JSON list of replayable, corroborated volume proofs; no implicit corrections.
VCI_VOLUME_PROOFS=
# Proxy routes are shuffled per request and failures fall through to another route.
# ALLOW_DIRECT=true includes direct access in the VN route pool, even with proxies.
# --allow-direct permits direct requests for one CLI invocation only.
ALLOW_DIRECT=true
HTTP_PROXIES=
PROVIDER_RPM=30
WORKER_CONCURRENCY=6
# Docker runs daily, hourly, and minute workers separately. Each defaults to
# 2 concurrent tasks and 10 requests/minute per provider route, keeping the
# previous combined budget while letting slow intervals progress independently.
DAILY_WORKER_CONCURRENCY=2
DAILY_PROVIDER_RPM=10
HOURLY_WORKER_CONCURRENCY=2
HOURLY_PROVIDER_RPM=10
MINUTE_WORKER_CONCURRENCY=2
MINUTE_PROVIDER_RPM=10
API_READ_CONCURRENCY=4
# These pools handle concurrent homepage reads; lower only on CPU-constrained hosts.
API_MARKET_READ_CONCURRENCY=4
API_MAX_LIMIT=40
REDIS_DAILY_MAX_SIZE=5000
REDIS_HOURLY_MAX_SIZE=30000
REDIS_MINUTE_MAX_SIZE=20000
# Optional Rust-compatible live cache. Leave empty for SQLite-emulated local reads.
REDIS_URL=
# Add other local origins only when browsers call the API directly. The Vite
# proxy uses the web origin and does not need a LAN IP listed here.
CORS_ORIGINS=https://aipriceaction.com,https://api.aipriceaction.com,http://localhost:5173,http://127.0.0.1:5173
AIPA_LOG_LEVEL=INFO
# OpenTelemetry tracing to OpenObserve. Disabled by default, like Rust.
OTEL_ENABLED=false
# This Python Compose stack has no OpenObserve container. Set a host reachable
# from the API container; this is the OpenObserve instance provided for this deployment.
OTEL_ENDPOINT=http://100.116.162.91:5080
# Service name shown in traces (default: aipriceaction)
OTEL_SERVICE_NAME=aipriceaction
# Optional OpenObserve auth header, for example: Basic <base64(user:password)>.
# Generate the value with: printf 'user:password' | base64
# Put the value in this project's .env; Compose does not read the legacy Rust .env.
OTEL_AUTH_HEADER=
# Comma-separated bearer tokens. Sync endpoints stay disabled until configured.
SYNC_TOKEN=
