[Unit]
Description=AIPriceAction encrypted SQLite backup to S3
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=@BACKUP_USER@
Group=@BACKUP_GROUP@
SupplementaryGroups=docker
WorkingDirectory=@PROJECT_DIR@
Environment=HOME=@USER_HOME@
Environment=AIPA_BACKUP_HOME=@STATE_ROOT@
Environment=AIPA_BACKUP_UID=@BACKUP_UID@
Environment=AIPA_BACKUP_GID=@BACKUP_GID@
EnvironmentFile=@STATE_ROOT@/config/backup.env
ExecStart=@PROJECT_DIR@/ops/backup/backup.sh
UMask=0077
Nice=10
KillMode=control-group
TimeoutStartSec=0
